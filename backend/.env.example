APP_NAME="Task PM App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tokyo
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=task_pm_app
DB_USERNAME=task_pm_app
DB_PASSWORD=secret

# 認証・DBキャッシュ・キューは使わない(単一ユーザー・同期処理のMVPのため、
# 追加テーブル(sessions/cache/jobs)が不要なfile/syncドライバを採用)
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
MAIL_MAILER=log

# 本番環境のみ使用。インフラ層(nginx等)のBasic認証用(アプリ機能としての認証ではない)。
# client-requirements.md / ADR-0003 参照
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
